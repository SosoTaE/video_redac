      "bg_color": "#181825F2",
      "corner_radius": 20,
      "padding": 34,
      "line_spacing": 1.45,
      "x": 90,
      "y": 390,
      "code": "func Search(a []int, key int) int {\n\tlo, hi := 0, len(a)-1\n\tfor lo <= hi {\n\t\tmid := lo + (hi-lo)/2\n\t\tswitch {\n\t\tcase a[mid] == key: return mid\n\t\tcase a[mid] < key:  lo = mid + 1\n\t\tdefault:            hi = mid - 1\n\t\t}\n\t}\n\treturn -1\n}"
    },
    {
      "id": "label_rs",
      "type": "text",
      "content": "Rust",
      "font": "DejaVu Sans-Bold",
      "size": 52,
      "color": "#FAB387",
      "x": 90,
      "y": 1080
    },
    {
      "id": "code_rs",
      "type": "code",
      "language": "rust",
      "font": "JetBrains Mono",
      "size": 26,
      "bg_color": "#181825F2",
      "corner_radius": 20,
      "padding": 34,
      "line_spacing": 1.45,
      "x": 90,
      "y": 1190,
      "code": "fn search(a: &[i32], key: i32) -> Option<usize> {\n    let (mut lo, mut hi) = (0usize, a.len());\n    while lo < hi {\n        let mid = lo + (hi - lo) / 2;\n        match a[mid].cmp(&key) {\n            Ordering::Equal   => return Some(mid),\n            Ordering::Less    => lo = mid + 1,\n            Ordering::Greater => hi = mid,\n        }\n    }\n    None\n}"
    },

