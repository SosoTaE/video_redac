      "color": "#CDD6F4",
      "bg_color": "#181825F2",
      "corner_radius": 20,
      "padding": 36,
      "line_spacing": 1.45,
      "x": 90,
      "y": 420,
      "code": "/* halve the range each step -> O(log n) */\n#include <stddef.h>\n\nint bsearch_i(const int *a, size_t n, int key)\n{\n    size_t lo = 0, hi = n - 1;\n\n    while (lo <= hi) {\n        size_t mid = lo + (hi - lo) / 2;\n\n        if (a[mid] == key) return (int)mid;\n        if (a[mid] <  key) lo = mid + 1;\n        else               hi = mid - 1;\n    }\n    return -1;   // not found\n}"
    },
