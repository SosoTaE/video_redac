      "x": 90,
      "y": 420,
      "code": "def search(a, key):\n    \"\"\"Return the index, or None if absent.\"\"\"\n    lo, hi = 0, len(a) - 1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if a[mid] == key:\n            return mid\n        if a[mid] < key:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return None"
    },
