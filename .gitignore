# ---------------------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------------------
build/
video_redac
*.o
*.d

# Temporary files from the debug build
*.silent.mp4

# ---------------------------------------------------------------------------
# Render output
# ---------------------------------------------------------------------------
#
# Every output video is written into out/. They are always reproducible from the
# JSON, so keeping them in the repository only adds size (~176 MB in this
# project).
out/
*.mp4
*.nut

# ---------------------------------------------------------------------------
# Media the repository should not carry
# ---------------------------------------------------------------------------
#
# Photos from the MLS listing: third-party copyright, and ~13 MB. They have to
# exist locally, because listing/*.json references them as photos/NN.jpg, but
# publishing them in a public repository would not be right.
listing/photos/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
*.swp
*~
.DS_Store
.vscode/
.idea/
