{
  "_comment": "ULTIMATE CONFIGURATION: The Chronos Engine (Pure Math & Geometry)",
  "vars": {
    "void_bg": "#020204",
    "core_gold": "#FFC107",
    "core_cyan": "#00E5FF",
    "core_crimson": "#FF1744",
    "text_hologram": "#E0F7FA",
    "font_main": "Inter-Black",
    "font_data": "FiraCode-Medium"
  },
  "project": {
    "width": 3840,
    "height": 2160,
    "fps": 120,
    "bg_color": "${void_bg}"
  },
  "output": {
    "encoder": "h264_nvenc",
    "preset": "p7",
    "cq": 12,
    "bitrate": "80M"
  },
  
  "styles": {
    "base_element": {
      "opacity": 1,
      "anchor": "middle"
    },
    "geometry_base": {
      "style": "base_element",
      "type": "rect"
    },
    "gear_tooth_cyan": {
      "style": "geometry_base",
      "color": "${core_cyan}",
      "w": 1200,
      "h": 4,
      "opacity": 0.4
    },
    "gear_tooth_gold": {
      "style": "geometry_base",
      "color": "${core_gold}",
      "w": 1800,
      "h": 2,
      "opacity": 0.3
    },
    "text_base": {
      "style": "base_element",
      "font": "Inter-Regular",
      "color": "${text_hologram}",
      "align": "center"
    },
    "text_massive": {
      "style": "text_base",
      "font": "${font_main}",
      "size": 280,
      "color": "#FFFFFF"
    },
    "data_stream_panel": {
      "type": "code",
      "font": "${font_data}",
      "size": 32,
      "padding": 40,
      "bg_color": "#00000000",
      "line_spacing": 1.5
    }
  },

  "scenes": [
    {
      "_comment": "SCENE 1: THE CLOCKWORK - კომპლექსური, მბრუნავი გეომეტრიული მექანიზმის აწყობა ხაზებით (სურათების გარეშე)",
      "id": "scene_01_clockwork",
      "duration": 8.0,
      "effects": [
        { "type": "vignette", "amount": 0.8, "radius": 0.5 },
        { "type": "color_grade", "hue": [ {"t":0,"v":0}, {"t":8,"v":45, "ease":"linear"} ] },
        { "type": "glow", "radius": 15 }
      ],
      "objects": [
        {
          "_comment": "ცენტრალური მბრუნავი ბირთვი (ოქროსფერი)",
          "id": "gear_gold_1", "style": "gear_tooth_gold", "x": "center", "y": "middle",
          "rotation": [ {"t":0,"v":0}, {"t":8,"v":180} ]
        },
        { "id": "gear_gold_2", "style": "gear_tooth_gold", "x": "center", "y": "middle", "rotation": [ {"t":0,"v":45}, {"t":8,"v":225} ] },
        { "id": "gear_gold_3", "style": "gear_tooth_gold", "x": "center", "y": "middle", "rotation": [ {"t":0,"v":90}, {"t":8,"v":270} ] },
        { "id": "gear_gold_4", "style": "gear_tooth_gold", "x": "center", "y": "middle", "rotation": [ {"t":0,"v":135}, {"t":8,"v":315} ] },
        
        {
          "_comment": "შიდა კონტრ-მბრუნავი ბირთვი (ცისფერი)",
          "id": "gear_cyan_1", "style": "gear_tooth_cyan", "x": "center", "y": "middle",
          "rotation": [ {"t":0,"v":0}, {"t":8,"v":-360, "ease":"smooth"} ]
        },
        { "id": "gear_cyan_2", "style": "gear_tooth_cyan", "x": "center", "y": "middle", "rotation": [ {"t":0,"v":60}, {"t":8,"v":-300, "ease":"smooth"} ] },
        { "id": "gear_cyan_3", "style": "gear_tooth_cyan", "x": "center", "y": "middle", "rotation": [ {"t":0,"v":120}, {"t":8,"v":-240, "ease":"smooth"} ] },
        
        {
          "_comment": "ილუზიური 3D სფერო ცენტრში (ორი წრის ზომების თამაშით)",
          "id": "core_orb", "type": "circle", "color": "${void_bg}", "cx": "center", "cy": "middle",
          "radius": [ {"t":0,"v":0}, {"t":3,"v":400, "ease":"expoout"} ]
        },
        {
          "id": "core_border", "type": "circle", "color": "${core_cyan}", "opacity": 0.5, "cx": "center", "cy": "middle",
          "radius": [ {"t":0,"v":0}, {"t":3.1,"v":410, "ease":"expoout"} ]
        },
        
        {
          "id": "main_title", "type": "text", "style": "text_base", "font": "Inter-Black", "size": 160,
          "content": "CHRONOS", "x": "center", "y": "middle", "color": "${core_gold}",
          "scale": [ {"t":0,"v":3.0}, {"t":4,"v":1.0, "ease":"elasticout"} ],
          "opacity": [ {"t":0,"v":0}, {"t":2,"v":1} ]
        },
        {
          "id": "sub_title", "type": "text", "style": "text_base", "font": "Inter-Light", "size": 50,
          "content": "TEMPORAL ENGINE ONLINE", "x": "center", "y": "middle+150",
          "opacity": 0
        }
      ],
      "timeline": [
        { "time_ms": 3000, "duration_ms": 2000, "action": "fade_in", "target": "sub_title" }
      ]
    },
    {
      "_comment": "SCENE 2: DATA FRACTAL - პროცესის დაჩქარება და კოდის გენერაცია",
      "id": "scene_02_fractal",
      "duration": 7.5,
      "bg_color": "#010103",
      "effects": [
        { "type": "scanlines", "amount": 0.4, "count": 2160 },
        { "type": "rgb_split", "amount": [ {"t":2,"v":0}, {"t":2.5,"v":25}, {"t":3,"v":0} ] },
        { "type": "glitch", "amount": [ {"t":6.5,"v":0}, {"t":7,"v":0.4}, {"t":7.5,"v":0.8} ] }
      ],
      "objects": [
        {
          "_comment": "ფონის პულსაცია (მასიური ოთხკუთხედები, რომლებიც ფონს ქმნიან)",
          "id": "bg_pulse_rect", "type": "rect", "color": "${core_crimson}", "w": 4000, "h": 2500,
          "x": "center", "y": "middle",
          "opacity": [ {"t":0,"v":0}, {"t":2.4,"v":0}, {"t":2.5,"v":0.2}, {"t":3.0,"v":0} ]
        },
        {
          "id": "terminal_sys1", "style": "data_stream_panel", "language": "cpp", "color": "${core_cyan}",
          "content": "void fold_spacetime(double t) {\n  for(int i=0; i<DIMENSIONS; i++) {\n    tensor_matrix[i].compress(t);\n    if (tensor_matrix.critical()) {\n       initiate_collapse();\n    }\n  }\n}",
          "x": "left+150", "y": "top+150", "anchor": "topleft"
        },
        {
          "id": "terminal_sys2", "style": "data_stream_panel", "language": "rust", "color": "${core_gold}",
          "content": "impl Timeline for Universe {\n    fn branch(&self) -> Self {\n        Timeline::new(self.seed ^ ENTHROPY)\n    }\n}",
          "x": "right-150", "y": "bottom-150", "anchor": "bottomright"
        },
        {
          "_comment": "პროგრესის მანიშნებელი, რომელიც მთელ ეკრანს ჭრის",
          "id": "progress_line", "type": "rect", "color": "#FFFFFF", "h": 8, "y": "middle", "anchor": "left",
          "x": "left", "w": [ {"t":0,"v":0}, {"t":7,"v":3840, "ease":"cubicinout"} ]
        },
        {
          "id": "warning_text", "type": "text", "style": "text_base", "font": "Inter-Bold", "size": 90, "color": "${core_crimson}",
          "content": "CRITICAL DENSITY REACHED", "x": "center", "y": "middle-100",
          "opacity": [ {"t":0,"v":0}, {"t":6.5,"v":0}, {"t":6.8,"v":1}, {"t":7,"v":0}, {"t":7.2,"v":1} ]
        }
      ],
      "timeline": [
        { "time_ms": 500, "duration_ms": 4000, "action": "typewrite", "target": "terminal_sys1" },
        { "time_ms": 2000, "duration_ms": 3000, "action": "typewrite", "target": "terminal_sys2" }
      ]
    },
    {
      "_comment": "SCENE 3: EVENT HORIZON - აბსოლუტური მინიმალიზმი ქაოსის შემდეგ (Contrast)",
      "id": "scene_03_horizon",
      "duration": 5.0,
      "bg_color": "#FFFFFF",
      "effects": [
        { "type": "invert", "amount": [ {"t":0,"v":1}, {"t":0.5,"v":0}, {"t":1.0,"v":1}, {"t":3.0,"v":0, "ease":"easeout"} ] },
        { "type": "grain", "amount": 0.08 }
      ],
      "objects": [
        {
          "_comment": "ცარიელი შავი ხვრელის ეფექტი",
          "id": "black_hole", "type": "circle", "color": "#000000", "cx": "center", "cy": "middle",
          "radius": [ {"t":0,"v":2000}, {"t":3,"v":200, "ease":"expoout"}, {"t":5,"v":210, "ease":"linear"} ]
        },
        {
          "id": "horizon_ring", "type": "circle", "color": "${core_cyan}", "opacity": 0.5, "cx": "center", "cy": "middle",
          "radius": [ {"t":0,"v":2100}, {"t":3.2,"v":220, "ease":"expoout"}, {"t":5,"v":230, "ease":"linear"} ]
        },
        {
          "id": "final_text", "style": "text_massive", "content": "RESET", "x": "center", "y": "middle",
          "scale": [ {"t":0,"v":0}, {"t":3,"v":0}, {"t":4,"v":1, "ease":"backout"} ]
        }
      ]
    }
  ],

  "transitions": [
    {
      "_comment": "TRANSITION 1: ურთულესი 'ჭიშკრის' (Gate) ეფექტი ნიღბით",
      "duration": 2.0,
      "toMask": {
        "shape": "rect", "x": 0.5, "y": 0.5,
        "w": [ {"t":0,"v":0}, {"t":0.5,"v":0.02}, {"t":1.5,"v":1, "ease":"expoinout"} ],
        "h": [ {"t":0,"v":0}, {"t":0.5,"v":1, "ease":"expoout"}, {"t":1.5,"v":1} ]
      },
      "from": {
        "scale": [ {"t":0,"v":1}, {"t":2,"v":3, "ease":"easein"} ],
        "rotate": [ {"t":0,"v":0}, {"t":2,"v":45, "ease":"easein"} ]
      }
    },
    {
      "_comment": "TRANSITION 2: გლიჩისა და ინვერსიის მყისიერი (Cut) გადასვლა",
      "use": "cut"
    }
  ]
}