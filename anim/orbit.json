{
  "_comment": "The `orbit` action: circular and spiral travel in closed form. Every motion here would otherwise be a polyline of keyframes.",

  "vars": { "p1": "#7EE787", "p2": "#79C0FF", "p3": "#D2A8FF", "p4": "#FFA657" },

  "project": { "width": 900, "height": 900, "fps": 60, "bg_color": "#0A0A0F", "duration_ms": 8000 },

  "objects": [
    { "id": "sun",   "type": "circle", "w": 56, "h": 56, "color": "#FFD166", "x": "center", "y": "center" },

    { "id": "m1", "type": "circle", "w": 18, "h": 18, "color": "${p2}", "x": 0, "y": 0 },
    { "id": "m2", "type": "circle", "w": 26, "h": 26, "color": "${p1}", "x": 0, "y": 0 },
    { "id": "m3", "type": "circle", "w": 14, "h": 14, "color": "${p3}", "x": 0, "y": 0 },

    { "id": "comet", "type": "rect", "w": 54, "h": 6, "color": "${p4}", "corner_radius": 3, "x": 0, "y": 0 },

    { "id": "cap", "type": "text", "content": "orbit — 0 keyframes",
      "x": "center", "y": "bottom-56", "size": 26, "color": "#8B949E", "font": "Inter" }
  ],

  "timeline": [
    { "time_ms": 0, "duration_ms": 600, "action": "fade_in", "target": "sun" },
    { "time_ms": 300, "duration_ms": 600, "action": "fade_in", "target": "cap" },

    { "time_ms": 0, "duration_ms": 8000, "action": "orbit", "target": "m1",
      "cx": "center", "cy": "center", "radius": 130, "from_angle": 0,   "sweep": 1440, "ease": "linear" },
    { "time_ms": 0, "duration_ms": 8000, "action": "orbit", "target": "m2",
      "cx": "center", "cy": "center", "radius": 230, "from_angle": 120, "sweep": 900,  "ease": "linear" },
    { "time_ms": 0, "duration_ms": 8000, "action": "orbit", "target": "m3",
      "cx": "center", "cy": "center", "radius": 330, "from_angle": 250, "sweep": 540,  "ease": "linear" },

    { "time_ms": 600, "duration_ms": 6400, "action": "orbit", "target": "comet",
      "cx": "center", "cy": "center", "radius": 60, "radius_to": 400,
      "from_angle": 0, "sweep": 1080, "orient": true, "ease": "cubicout" },

    { "time_ms": 7400, "duration_ms": 600, "action": "fade_out", "target": "cap" }
  ]
}
