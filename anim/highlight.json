{
  "_comment": "Walks a highlight band down a code block — the `highlight` timeline action.",

  "vars": { "accent": "#F0B23940", "hit": "#3FB95055", "miss": "#F8514955" },

  "project": { "width": 1000, "height": 800, "fps": 60, "bg_color": "#0D1117", "duration_ms": 9000 },

  "objects": [
    { "id": "title", "type": "text", "content": "binary search — one step at a time",
      "x": "center", "y": 48, "size": 30, "color": "#8B949E", "font": "Inter" },

    { "id": "snippet", "type": "code", "language": "python",
      "x": "center", "y": "center+56", "size": 26,
      "padding": 32, "corner_radius": 14, "bg": "#161B22", "highlight": true,
      "code": "def binary_search(a, target):\n    lo, hi = 0, len(a) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if a[mid] == target:\n            return mid\n        elif a[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1" }
  ],

  "timeline": [
    { "time_ms": 300,  "duration_ms": 500, "action": "fade_in", "target": "title" },

    { "time_ms": 800,  "duration_ms": 350, "action": "highlight", "target": "snippet",
      "line": 3, "color": "${accent}" },
    { "time_ms": 2000, "duration_ms": 350, "action": "highlight", "target": "snippet",
      "line": 4, "color": "${accent}" },
    { "time_ms": 3400, "duration_ms": 350, "action": "highlight", "target": "snippet",
      "from": 5, "to": 6, "color": "${hit}" },
    { "time_ms": 5000, "duration_ms": 350, "action": "highlight", "target": "snippet",
      "from": 7, "to": 8, "color": "${accent}" },
    { "time_ms": 6600, "duration_ms": 350, "action": "highlight", "target": "snippet",
      "line": 11, "color": "${miss}" },

    { "time_ms": 8300, "duration_ms": 600, "action": "fade_out", "target": "snippet" },
    { "time_ms": 8300, "duration_ms": 600, "action": "fade_out", "target": "title" }
  ]
}
